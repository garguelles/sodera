# Node verification settings.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ZERODEV_SEPOLIA_BUNDLER_RPC=
# Funded Sepolia key for `pnpm demo:aqua-trade`, which trades against an Earn position. Never a real wallet.
AQUA_DEMO_TRADER_KEY=

# Mobile proof settings are embedded in the app and must be treated as public.
EXPO_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EXPO_PUBLIC_ZERODEV_SEPOLIA_BUNDLER_RPC=

# MultiBaas verification settings.
MULTIBAAS_BASE_URL=
MULTIBAAS_API_KEY=

# MultiBaas mobile settings are embedded in the app and must be treated as public.
EXPO_PUBLIC_MULTIBAAS_BASE_URL=
EXPO_PUBLIC_MULTIBAAS_API_KEY=

# Wallet agent (optional). Public: embedded in the app. Leave the URL or token empty to hide
# the assistant button. For a local agent, use this Mac's Wi-Fi address with the phone on the same network.
EXPO_PUBLIC_AGENT_BASE_URL=
EXPO_PUBLIC_AGENT_APP_TOKEN=
# Placeholder contacts for the agent until the address book or ENS lands: name=0x…,name=0x…
EXPO_PUBLIC_AGENT_CONTACTS=
