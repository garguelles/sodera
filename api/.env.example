PORT=8080
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Provision PostgreSQL and set these as secrets to enable ENS proof endpoints.
DATABASE_URL=
ENS_CHALLENGE_IP_KEY=
# Keep claims disabled until the private issuer worker is verified and the owner grants ROLE_REGISTRAR.
ENS_CLAIMS_ENABLED=0
# Local private worker only; 64 hex characters with or without 0x. Never passed to the public API container.
ENS_ISSUER_PRIVATE_KEY=
