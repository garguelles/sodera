{
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	handle /.well-known/assetlinks.json {
		header Content-Type application/json
		header Cache-Control "public, max-age=300"
		file_server
	}

	# ANDROID_APK_URL is a Railway variable holding the approved APK's bucket link.
	handle /download/android {
		header Cache-Control "no-store"
		redir {$ANDROID_APK_URL:/} 302
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
